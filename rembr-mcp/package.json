{
  "name": "@rembr/mcp-server",
  "version": "1.12.0",
  "description": "Context infrastructure for Recursive Language Models - Production-ready persistence layer for RLM agents",
  "main": "index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/evaluations/system-one/pilot-evidence && cp src/evaluations/system-one/pilot-evidence/*.jsonl dist/evaluations/system-one/pilot-evidence/",
    "start": "node dist/index-http.js",
    "start:maintenance": "node dist/maintenance-worker.js",
    "start:system-one-shadow": "node dist/system-one-shadow-worker.js",
    "start:system-one-shadow-proxy": "node dist/system-one-fixed-egress-proxy.js",
    "system-one-shadow:admin": "node dist/system-one-shadow-admin.js",
    "dev": "tsc && node dist/index-http.js",
    "test": "vitest run",
    "test:unit": "TEST_SUITE=unit vitest run",
    "test:integration": "TEST_SUITE=integration vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headless": "xvfb-run --auto-servernum --server-args='-screen 0 1920x1080x24' playwright test",
    "pretest:e2e": "node ../scripts/check-playwright-version.js",
    "eval:system-one:baseline": "npm run build && node dist/evaluations/system-one/run-baseline.js",
    "eval:system-one:generative-baseline": "npm run build && node dist/evaluations/system-one/run-generative-baseline.js",
    "eval:system-one:jev": "npm run build && node dist/evaluations/system-one/run-jev.js"
  },
  "keywords": [
    "mcp",
    "rlm",
    "recursive-language-model",
    "context",
    "memory",
    "ai-agents",
    "semantic-search"
  ],
  "author": "Mark @ radicalgeek",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.985.0",
    "@mcp-ui/server": "^6.1.0",
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "express": "^4.18.2",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "ollama": "^0.5.18",
    "pg": "^8.17.2",
    "prom-client": "^15.1.0",
    "undici": "7.29.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.2.0",
    "@vitest/coverage-v8": "^3.2.6",
    "@vitest/ui": "^3.2.6",
    "patch-package": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "fast-xml-parser": ">=5.3.5"
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0",
    "npm": ">=9.0.0"
  }
}
