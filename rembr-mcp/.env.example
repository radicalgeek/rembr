# Database (component-based connection, preferred for production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rembr
DB_USER=rembr_app
DB_PASSWORD=your-db-password
DB_READ_HOST=localhost
DB_READ_PASSWORD=your-db-password

# Or use a connection string (takes precedence if set)
# DATABASE_URL="postgresql://rembr_app:password@localhost:5432/rembr"

# Redis (session store + embedding cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
# Or use a URL (takes precedence if set)
# REDIS_URL="redis://:password@localhost:6379"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-jwt-secret-here"
API_KEY_SECRET="generate-an-independent-random-value"

# Ollama Embedding Service
OLLAMA_HOST="http://localhost:11434"

# Or use any OpenAI-compatible embedding endpoint.
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=http://localhost:4000/v1
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBEDDING_DIMENSIONS=768

# Server Configuration
PORT=3000
NODE_ENV=production
PUBLIC_URL="http://localhost:3000"
# UI_BASE_URL is listed by environment validation but not currently read by the engine.
UI_BASE_URL="http://localhost:8080"
OAUTH_EXPECTED_ISSUER="http://localhost:3000"
OAUTH_EXPECTED_AUDIENCE="http://localhost:3000/mcp"

# Tenant-wide automatic mutation remains disabled until optimisation services
# enforce user/project audiences and produce reviewable proposals.
ENABLE_OPTIMIZATION=false
# Reserved: memory evolution is proposal-only and never applies rewrites today.
MEMORY_EVOLUTION_APPLY_ENABLED=false

# Optional OpenAI-compatible text generation for relationship classification and
# background memory evolution. The LM_STUDIO_* names are retained for backwards
# compatibility; OpenAI-compatible gateways and local model servers work too.
# TEXT_GENERATION_PROVIDER=openai-compatible
# LM_STUDIO_BASE_URL=http://localhost:4000/v1
# LM_STUDIO_MODEL=qwen3
# TEXT_GENERATION_TIMEOUT_MS=180000

# Maintenance worker job types (dist/maintenance-worker.js). The worker runs a
# job type unless its flag is exactly "false", so keep these explicit and
# enable each mutating or LLM-backed job type deliberately.
MEMORY_EVOLUTION_ENABLED=false
# LLM assessment of evolution candidates; off unless exactly "true".
MEMORY_EVOLUTION_ASSESSMENT_ENABLED=false
MAINTENANCE_RELATIONSHIP_ENABLED=false
MAINTENANCE_CONTRADICTION_ENABLED=false
MAINTENANCE_CLEANUP_ENABLED=false
MAINTENANCE_EVOLUTION_BATCH_SIZE=2
MAINTENANCE_EVOLUTION_MIN_CONFIDENCE=0.85

# CORS (comma-separated origins for development)
# CORS_ORIGIN is listed by environment validation but not currently read by the engine.
CORS_ORIGIN="http://localhost:3000"

# ─── Security (REM-28) ─────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32

# Admin endpoints authentication (X-Admin-Key header) — RAD-45
# Required: server refuses to start if this is not set.
# All /admin/* routes check this key. Generate: openssl rand -hex 32
ADMIN_API_KEY="change-me-generate-with-openssl-rand-hex-32"

# Prometheus /metrics endpoint authentication (Bearer token or X-Metrics-Token header)
# In production: MUST be set — /metrics returns 403 without this.
# In development: optional (endpoint is open if unset).
METRICS_SECRET="change-me-generate-with-openssl-rand-hex-32"

# ─── Contradiction Detection Tuning (RAD-62) ──────────────────────────────────
# Per-LLM-call timeout (ms) for background contradiction analysis.
# Default: 8000ms. Increase on dedicated GPU; decrease to fail fast under contention.
# CONTRADICTION_DETECTION_TIMEOUT_MS=8000

# Max similar memories to check per store_memory call (caps total LLM calls).
# Default: 5. Lower values reduce GPU contention; raise if coverage matters more.
# CONTRADICTION_MAX_CANDIDATES=5

# Ollama model for contradiction analysis.
# Defaults to OLLAMA_TEXT_MODEL (llama3.1:8b). Use a faster/smaller model to
# reduce GPU contention with the embedding model (nomic-embed-text).
# Examples: qwen2:1.5b, tinyllama, phi3.5-mini
# OLLAMA_CONTRADICTION_MODEL=llama3.1:8b

# ─── Azure OpenAI provider (optional) ──────────────────────────────────────────
# Embeddings: EMBEDDING_PROVIDER=azure
# Text generation: TEXT_GENERATION_PROVIDER=azure (independent of embeddings)
# Azure is not drop-in OpenAI-compatible — it uses deployment-based URLs, an
# api-key header, and a native `dimensions` param. Set EMBEDDING_DIMENSIONS=768
# to match the pgvector schema.
# EMBEDDING_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT="https://my-resource.openai.azure.com"
# AZURE_OPENAI_API_KEY="your-azure-openai-key"
# AZURE_OPENAI_API_VERSION="2024-10-21"
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
# AZURE_OPENAI_TEXT_DEPLOYMENT="gpt-5-mini"
# EMBEDDING_DIMENSIONS=768

# Disable SaaS request quotas only for a trusted private deployment.
RATE_LIMIT_DISABLED=false
