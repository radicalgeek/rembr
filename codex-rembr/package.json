{
  "name": "codex-rembr",
  "version": "0.1.3",
  "description": "Rembr memory for OpenAI Codex: stdio MCP bridge with curated memory tools, plus config recipes and an agent skill.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "codex-rembr": "dist/cli.js",
    "codex-rembr-distill": "dist/distill-cli.js",
    "codex-rembr-recall-hook": "dist/recall-hook-cli.js",
    "codex-rembr-watch": "dist/watch-cli.js"
  },
  "files": [
    "dist",
    "plugin-dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && npm run build:plugin",
    "build:plugin": "esbuild src/cli.ts src/recall-hook-cli.ts src/distill-cli.ts --bundle --platform=node --format=esm --outdir=plugin-dist && node scripts/format-plugin-dist.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "codex",
    "mcp",
    "memory",
    "rembr",
    "ai-agents"
  ],
  "author": "Mark @ radicalgeek",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
