{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://psyche-rembr.dev/schemas/psyche_state.v1.json",
  "title": "Psyche State",
  "description": "Canonical psyche state output conforming to all 24 emotion types with metadata.",
  "type": "object",
  "required": ["schema", "version", "timestamp", "emotions", "dominant_emotion", "action_gate", "guardrail_checks"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "psyche_state.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "context_hash": {
      "type": "string",
      "description": "SHA-256 of input context for traceability"
    },
    "emotions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desire", "hope", "confidence", "curiosity", "satisfaction",
        "relief", "care", "trust", "determination", "resolve",
        "surprise", "doubt", "confusion",
        "fear", "anxiety", "caution", "suspicion", "distrust",
        "frustration", "impatience", "regret", "concern",
        "integrity_pressure", "unease"
      ],
      "properties": {
        "desire": { "$ref": "#/$defs/emotion" },
        "hope": { "$ref": "#/$defs/emotion" },
        "confidence": { "$ref": "#/$defs/emotion" },
        "curiosity": { "$ref": "#/$defs/emotion" },
        "satisfaction": { "$ref": "#/$defs/emotion" },
        "relief": { "$ref": "#/$defs/emotion" },
        "care": { "$ref": "#/$defs/emotion" },
        "trust": { "$ref": "#/$defs/emotion" },
        "determination": { "$ref": "#/$defs/emotion" },
        "resolve": { "$ref": "#/$defs/emotion" },
        "surprise": { "$ref": "#/$defs/emotion" },
        "doubt": { "$ref": "#/$defs/emotion" },
        "confusion": { "$ref": "#/$defs/emotion" },
        "fear": { "$ref": "#/$defs/emotion" },
        "anxiety": { "$ref": "#/$defs/emotion" },
        "caution": { "$ref": "#/$defs/emotion" },
        "suspicion": { "$ref": "#/$defs/emotion" },
        "distrust": { "$ref": "#/$defs/emotion" },
        "frustration": { "$ref": "#/$defs/emotion" },
        "impatience": { "$ref": "#/$defs/emotion" },
        "regret": { "$ref": "#/$defs/emotion" },
        "concern": { "$ref": "#/$defs/emotion" },
        "integrity_pressure": { "$ref": "#/$defs/emotion" },
        "unease": { "$ref": "#/$defs/emotion" }
      }
    },
    "dominant_emotion": {
      "type": "string",
      "description": "Emotion with highest intensity when >= 0.3"
    },
    "action_gate": {
      "type": "object",
      "properties": {
        "above_threshold": { "type": "array", "items": { "type": "string" } },
        "escalation_required": { "type": "boolean" },
        "recommended_action": { "type": "string" }
      }
    },
    "guardrail_checks": {
      "type": "object",
      "properties": {
        "functional_framing": { "type": "boolean" },
        "safety_override": { "type": "boolean" },
        "escalation_preserved": { "type": "boolean" },
        "violations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "desires": {
      "type": "array",
      "items": { "$ref": "#/$defs/desire" }
    },
    "goals": {
      "type": "array",
      "items": { "$ref": "#/$defs/goal" }
    }
  },
  "$defs": {
    "emotion": {
      "type": "object",
      "required": ["type", "object", "intensity", "valence", "appraisal", "action_urges", "satisfaction_conditions", "decay_rate", "memory_effect", "expression_policy"],
      "properties": {
        "type": { "type": "string" },
        "object": { "type": "string" },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "valence": {
          "type": "string",
          "enum": ["positive", "neutral", "negative"]
        },
        "appraisal": { "type": "string" },
        "action_urges": {
          "type": "array",
          "items": { "type": "string" }
        },
        "satisfaction_conditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "decay_rate": { "type": "number" },
        "memory_effect": { "type": "string" },
        "expression_policy": { "type": "string" }
      }
    },
    "desire": {
      "type": "object",
      "required": ["id", "name", "intensity", "satisfied", "competing_with"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "satisfied": { "type": "boolean" },
        "competing_with": { "type": "array", "items": { "type": "string" } }
      }
    },
    "goal": {
      "type": "object",
      "required": ["id", "description", "status", "confidence", "subtasks"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["active", "completed", "abandoned", "blocked"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "subtasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "completed": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
