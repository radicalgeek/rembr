# Rembr self-hosted stack configuration (docker compose).
# Copy to .env and adjust. See SELF-HOSTING.md.

# Generate each value independently (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=
DB_APP_PASSWORD=

# Required by the engine for JWT signing — set a long random value
JWT_SECRET=
PUBLIC_URL=http://127.0.0.1:3000
# Canonical OAuth resource/audience; keep the /mcp suffix.
OAUTH_AUDIENCE=http://127.0.0.1:3000/mcp
API_KEY_SECRET=
ADMIN_API_KEY=
METRICS_SECRET=

# API key for the console (printed by rembr-mcp/scripts/bootstrap-tenant.mjs)
REMBR_API_KEY=

# Dedicated browser-to-console bearer token. It must differ from REMBR_API_KEY.
REMBR_CONSOLE_AUTH_TOKEN=
# The console is read-only unless this is deliberately changed to read-write.
REMBR_CONSOLE_MODE=read-only
# Console authentication: "static" (default) uses REMBR_API_KEY and
# REMBR_CONSOLE_AUTH_TOKEN above. "session" lets each user sign in with their
# own API key, ignores both values above, and requires TLS in front of the
# console (the session cookie is Secure) plus REMBR_CONSOLE_ALLOWED_ORIGINS set
# to the exact public origin. See rembr-console/README.md.
REMBR_CONSOLE_AUTH_MODE=static
# REMBR_CONSOLE_ALLOWED_ORIGINS=https://console.example
# Host publishing defaults to loopback. Set these only when a protected reverse
# proxy or firewall provides the intended external boundary.
REMBR_BIND_ADDRESS=127.0.0.1
CONSOLE_BIND_ADDRESS=127.0.0.1
CONSOLE_PORT=8080
# Disable SaaS request quotas only for a trusted private deployment.
RATE_LIMIT_DISABLED=false

# Embeddings: default is local Ollama (start with: docker compose --profile ollama up -d)
# then pull the model once: docker compose exec ollama ollama pull nomic-embed-text
EMBEDDING_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Or an unauthenticated local/trusted OpenAI-compatible endpoint instead:
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=http://your-container-reachable-host:1234/v1
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBEDDING_DIMENSIONS=768

# Optional TypeSafe System One/Jev relationship decisions.
# Leave disabled for the fully local default. See SELF-HOSTING.md before enabling.
SYSTEM_ONE_INTEGRATION_ENABLED=false
SYSTEM_ONE_SHADOW_CAPTURE_ENABLED=false
DB_SHADOW_PASSWORD=
TYPESAFE_API_KEY=
SYSTEM_ONE_SHADOW_TENANT_ID=
SYSTEM_ONE_SHADOW_PROJECT_ID=
SYSTEM_ONE_SHADOW_RUN_ID=
SYSTEM_ONE_SHADOW_SAMPLE_RATE=1
SYSTEM_ONE_SHADOW_MAX_CANDIDATES_PER_MEMORY=8
SYSTEM_ONE_SHADOW_MAX_REQUESTS_PER_CYCLE=1
SYSTEM_ONE_SHADOW_INTERVAL_MS=60000
SYSTEM_ONE_SHADOW_TIMEOUT_MS=30000

# Or Azure OpenAI (deployment-based URLs + api-key header + native dimensions).
# Request EMBEDDING_DIMENSIONS=768 to match the default pgvector schema.
# EMBEDDING_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# EMBEDDING_DIMENSIONS=768

# Optional text generation for the opt-in maintenance worker
# (docker compose --profile maintenance). Point this at OpenAI, a local gateway,
# or any OpenAI-compatible chat endpoint.
# TEXT_GENERATION_PROVIDER=openai-compatible
# LM_STUDIO_BASE_URL=http://your-openai-compatible-host:4000/v1
# LM_STUDIO_MODEL=qwen3
# TEXT_GENERATION_TIMEOUT_MS=180000
# Maintenance job types. Embedding backfill and expired-snapshot cleanup always
# run; the optional job types below default to off in this stack. Enable each
# one deliberately. See SELF-HOSTING.md.
MEMORY_EVOLUTION_ENABLED=false
MEMORY_EVOLUTION_ASSESSMENT_ENABLED=false
# Reserved: evolution is proposal-only and never applies rewrites today.
MEMORY_EVOLUTION_APPLY_ENABLED=false
MAINTENANCE_RELATIONSHIP_ENABLED=false
MAINTENANCE_CONTRADICTION_ENABLED=false
MAINTENANCE_CLEANUP_ENABLED=false
MAINTENANCE_EVOLUTION_BATCH_SIZE=2
MAINTENANCE_EVOLUTION_MIN_CONFIDENCE=0.85

# Azure text generation (optional, independent of the embedding provider):
# TEXT_GENERATION_PROVIDER=azure
# AZURE_OPENAI_TEXT_DEPLOYMENT=gpt-5-mini

# Console session lifetime in milliseconds (defaults: 30-minute idle, 8-hour absolute).
# REMBR_CONSOLE_SESSION_IDLE_MS=1800000
# REMBR_CONSOLE_SESSION_ABSOLUTE_MS=28800000
